<UserControl x:Class="Lab03.Views.ReservasObjetosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Listado de Reservas" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <Border Background="#DCFCE7" CornerRadius="4" HorizontalAlignment="Left" Padding="8,3" Margin="0,5,0,0">
                <TextBlock Text="Modo Conectado (List&lt;Reserva&gt; / SqlDataReader)" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
            </Border>
        </StackPanel>

        <!-- Tabla Estilizada -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Reservas}" AutoGenerateColumns="True" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      Background="Transparent" BorderThickness="0" RowHeight="36">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Height" Value="38"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>