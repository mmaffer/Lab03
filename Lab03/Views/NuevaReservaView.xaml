<UserControl x:Class="Lab03.Views.NuevaReservaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Registrar Nueva Reserva" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Séquito de parámetros para la reserva de aulas" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Formulario en Tarjeta Centrada -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Top" MaxWidth="600" HorizontalAlignment="Left">
            <StackPanel>
                <!-- Selección de Aula -->
                <TextBlock Text="Seleccionar Aula" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Aulas}" DisplayMemberPath="Nombre" SelectedItem="{Binding AulaSeleccionada}"
                          Padding="10,8" FontSize="13" Margin="0,0,0,15" Height="38"/>

                <!-- Fecha de Reserva -->
                <TextBlock Text="Fecha de Reserva" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding FechaReserva}" Padding="10,5" FontSize="13" Margin="0,0,0,15" Height="38"/>

                <!-- Horarios (Inicio y Fin) -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hora Inicio (ej: 08:00)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HoraInicio}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hora Fin (ej: 10:00)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HoraFin}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- Motivo -->
                <TextBlock Text="Motivo / Descripción" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Motivo}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                <!-- Mensaje de Estado -->
                <TextBlock Text="{Binding Mensaje}" Foreground="#16A34A" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Botón de Guardado -->
                <Button Content="💾 Guardar Reserva" Command="{Binding GuardarCommand}" 
                        Height="42" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="#16A34A">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>  