<Window x:Class="Lab03.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión - Reservas" Height="500" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F1F5F9">

    <Grid>
        <!-- Fondo Decorativo Superior -->
        <Border Height="180" VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Tarjeta de Login -->
        <Border Background="White" CornerRadius="12" Margin="35,60,35,35" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.1" Color="#0F172A"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="¡Bienvenido!" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                <TextBlock Text="Ingresa tus credenciales para continuar" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <!-- Campo Usuario -->
                <TextBlock Text="Usuario" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#0F172A" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Campo Contraseña -->
                <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" PasswordChanged="TxtPassword_PasswordChanged" 
                             Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#0F172A" Margin="0,0,0,15">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- Mensaje de Error -->
                <TextBlock Text="{Binding MensajeError}" Foreground="#EF4444" FontSize="12" HorizontalAlignment="Center" 
                           Margin="0,0,0,15" TextWrapping="Wrap" Visibility="{Binding MensajeError, Converter={x:Null}}"/>

                <!-- Botón Ingresar -->
                <Button Content="Iniciar Sesión" Command="{Binding LoginCommand}" IsDefault="True"
                        Height="42" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="#4F46E5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>